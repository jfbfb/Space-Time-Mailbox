# 服务端端口（浏览器访问）
PORT=3000

# 监听地址：0.0.0.0 表示监听所有网卡（局域网可访问）
HOST=0.0.0.0

# 数据库文件路径（SQLite）
DATABASE_PATH=./letters.sqlite

# 调度器轮询间隔（毫秒）
POLL_INTERVAL_MS=30000

# 一次最多尝试发送的“到点未发送”任务数
DUE_LIMIT=20

#
# SMTP 配置：用于在“收到信的时间”到点后发送真实邮件
#
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_username
SMTP_PASS=your_password_or_app_password

# 发送方地址（通常需要在 SMTP 平台上已验证）
SMTP_FROM=you@example.com

# 可选：是否使用 secure 连接（通常 465 => true，587 => false）
# 你也可以不填写，让程序根据 SMTP_PORT 自动推断：
# - 465 => secure=true
# - 其他（默认 587）=> secure=false
SMTP_SECURE=

# 可选：邮件主题
LETTER_SUBJECT=来自过去的你的一封信

